server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # React Router 대응: 어떤 경로든 index.html로 (SPA 새로고침 404 방지)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # /api 로 시작하는 요청은 백엔드 컨테이너로 전달
    # context-path가 /api 이므로 /api/ 를 백엔드의 /api/ 로 그대로 넘김
    location /api/ {
        proxy_pass http://backend:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 아래 3개(${...})가 컨테이너 시작 시 docker-compose의 environment 값으로 치환됨.
        # OAuth redirect_uri가 "브라우저가 실제 접속한 주소"로 만들어지게 하는 핵심.
        proxy_set_header X-Forwarded-Proto ${PUBLIC_PROTO};
        proxy_set_header X-Forwarded-Host  ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-Port  ${PUBLIC_PORT};
    }
}